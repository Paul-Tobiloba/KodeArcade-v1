{
  "name": "kodearcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:vercel": "npm run check:server && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "dev:server": "tsx watch server/index.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "test:server": "vitest run --config vitest.server.config.ts",
    "email:test": "tsx server/email/test-send.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx server/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@vercel/functions": "3.10.1",
    "better-auth": "1.7.7",
    "blockly": "^13.3.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "4.6.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.56.0",
    "@types/node": "26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "5.0.3"
  }
}
