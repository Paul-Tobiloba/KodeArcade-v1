# Server only. Never prefix database URLs or secrets with VITE_.
# Copy to .env (gitignored). These placeholders cannot start the server.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Neon pooled URL, ideally using a runtime role without schema/DDL privileges.
DATABASE_URL=postgresql://ROLE:PASSWORD@ENDPOINT-pooler.eu-west-2.aws.neon.tech/kodearcade?sslmode=verify-full
# Direct owner/migration URL, used only by db:migrate. Never ship to the browser.
DATABASE_MIGRATION_URL=postgresql://ROLE:PASSWORD@ENDPOINT.eu-west-2.aws.neon.tech/kodearcade?sslmode=verify-full
# Migration safety check: exactly match the intended database hostname.
DATABASE_MIGRATION_HOST=ENDPOINT.eu-west-2.aws.neon.tech

# Optional adult verification/reset mail. Never use VITE_ for these fields.
# Development sends only to this exact recipient; it does not redirect other users' tokens.
EMAIL_DELIVERY_MODE=development
RESEND_API_KEY=REPLACE_WITH_RESEND_SENDING_KEY
EMAIL_FROM="KodeArcade <onboarding@resend.dev>"
# Use the email address attached to your Resend account. No domain purchase needed for this test.
EMAIL_TEST_RECIPIENT=
# Later: production requires NODE_ENV=production, explicit EMAIL_DELIVERY_MODE=production,
# a verified custom-domain EMAIL_FROM and removal of EMAIL_TEST_RECIPIENT.

# Optional private ADULT AI lab. Development only; never enables student AI.
BYTE_PILOT_ENABLED=false
# Loopback SSH tunnel to the private gateway; never point this at raw Ollama.
BYTE_GATEWAY_URL=http://127.0.0.1:11435
BYTE_GATEWAY_TOKEN=
# Comma-separated verified adult auth user IDs, obtained privately by the operator.
BYTE_PILOT_ADULT_IDS=
